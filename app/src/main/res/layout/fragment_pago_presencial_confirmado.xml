<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/white"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_circulo_check"
        android:gravity="center"
        android:layout_marginBottom="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pago_presencial_exitoso"
        android:textColor="@color/color_letra_2"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_boton_blanco"
        android:padding="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_numero_preregistro"
            android:textColor="@color/color_letra_2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvNumeroPresencial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/color_letra_1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:textAlignment="center"/>
    </LinearLayout>

    <!-- Solo botón Inicio — sin comprobante -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInicioPresencial"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_inicio"
        android:textColor="@color/color_letra_1"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/white"
        app:cornerRadius="12dp"
        app:strokeColor="@color/color_letra_1"
        app:strokeWidth="1.5dp"/>

</LinearLayout>