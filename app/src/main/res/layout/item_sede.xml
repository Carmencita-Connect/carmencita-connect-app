<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/color_borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="116dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/descripcion_icono_agencia"
            android:src="@drawable/ico_ver_agencias" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/color_letra_2"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDireccionSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_ubicacion_sede"
                android:textColor="@color/color_letra_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTelefonoSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_telefono_sede"
                android:textColor="@color/color_letra_2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvHorarioSede"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_horario_sede"
                android:textColor="@color/color_letra_2"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLlamarSede"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/hu14_descripcion_llamar_sede"
                android:minWidth="120dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/hu14_btn_llamar_sede"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/color_letra_1"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_telefono_sede"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconTint="@color/white" />

        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/descripcion_abrir_ubicacion"
            android:src="@drawable/ic_flecha_derecha" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
